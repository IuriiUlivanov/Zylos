<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_route_panel"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/route_row_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/routeMyLocation"
                    android:layout_width="@dimen/route_side_btn"
                    android:layout_height="@dimen/route_side_btn"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ruta_moja_lokacija"
                    android:src="@drawable/ic_my_location"
                    app:tint="@color/muted" />

                <EditText
                    android:id="@+id/routeFromInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/ruta_od_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/routeFromMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="@string/ruta_na_karti"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/route_row_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/route_side_btn"
                    android:layout_height="@dimen/route_side_btn" />

                <EditText
                    android:id="@+id/routeToInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/ruta_do_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/routeToMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="@string/ruta_na_karti"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/routeSwap"
            android:layout_width="@dimen/route_swap_width"
            android:layout_height="92dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ruta_swap_cd"
            android:src="@drawable/ic_swap"
            app:tint="@color/muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/route_mode_height"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/routeModeWalk"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mode_off"
            android:contentDescription="@string/ruta_peske"
            android:src="@drawable/ic_walk"
            app:tint="@color/muted" />

        <ImageButton
            android:id="@+id/routeModeTransit"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mode_on"
            android:contentDescription="@string/ruta_prevoz"
            android:src="@drawable/ic_bus"
            app:tint="@color/accent" />

        <ProgressBar
            android:id="@+id/routeSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
