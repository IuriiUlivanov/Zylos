<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zylos" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/map_bg</item>
        <item name="android:windowBackground">@color/map_bg</item>
    </style>

    <style name="Theme.Zylos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/map_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Zylos</item>
    </style>
</resources>
